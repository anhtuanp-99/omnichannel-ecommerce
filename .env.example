# ========================================================
# INFRASTRUCTURE & CREDENTIALS (TEMPLATE)
# Sao chép file này thành .env và điền các giá trị thực tế
# ========================================================

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=postgres
DB_PORT=5432

# MongoDB (No Auth)
MONGO_PORT=27017

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka & Kafka UI
KAFKA_PORT=29092
KAFKA_UI_PORT=8090

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Elasticsearch
ES_PORT=9200

# ========================================================
# APPLICATION & GATEWAY PORTS
# ========================================================
EUREKA_SERVER_URL=http://localhost:8761/eureka
GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
CATALOG_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8083
PAYMENT_SERVICE_PORT=8084
NOTIFICATION_SERVICE_PORT=8085

# Security / CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173