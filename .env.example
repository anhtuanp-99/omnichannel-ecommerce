# ========================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành .env: `cp .env.example .env`
# ========================================================

# PostgreSQL
DB_USER=postgres
DB_PASSWORD=change_this_to_your_password
DB_NAME=postgres
DB_PORT=5433

# MongoDB
MONGO_PORT=27018

# Redis
REDIS_PORT=6379

# Kafka
KAFKA_PORT=29092
KAFKA_UI_PORT=8090

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Elasticsearch
ES_PORT=9200